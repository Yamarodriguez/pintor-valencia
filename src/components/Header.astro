---
import site from '../data/site.json';
import menu from '../data/menu.json';
const { rutaActual } = Astro.props;
const img = (ruta) => site.baseImagenes + ruta;

/* Todos los enlaces de un elemento del menú, sea cual sea su forma. */
const enlaces = (i) => [
  ...(i.hijos ?? []),
  ...(i.columnas ?? []).flatMap((c) => c.enlaces),
];
const activo = (i) => i.url === rutaActual || enlaces(i).some((h) => h.url === rutaActual);

// No mostrar el aviso del email mientras siga con el marcador PENDIENTE.
const emailPuesto = site.email && !site.email.startsWith('PENDIENTE');
---
<header class="cabecera">
  {emailPuesto && (
    <div class="cabecera__aviso">
      <div class="contenedor">
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  )}

  <div class="contenedor cabecera__barra">
    <a class="cabecera__logo" href="/">
      <img src={img(site.logo)} alt={site.logoAlt}
           width="451" height="257" fetchpriority="high" decoding="async" />
    </a>

    {/* Casilla oculta + etiqueta: hamburguesa sin JavaScript. No uso
        <details> porque los navegadores ocultan su contenido con
        content-visibility y no se puede forzar visible en escritorio. */}
    <input type="checkbox" id="abrir-menu" class="conmutador" />
    <label for="abrir-menu" class="menu__boton">
      <span class="menu__barras" aria-hidden="true"></span>
      <span>Menú</span>
    </label>

    <nav class="menu__nav" aria-label="Principal">
      <ul class="nav">
        {menu.principal.map((item, n) => (item.hijos || item.columnas) ? (
          <li class:list={['nav__grupo', { 'nav__grupo--mega': item.columnas, 'es-activo': activo(item) }]}>
            <input type="checkbox" id={`grupo-${n}`} class="conmutador" />
            <div class="nav__fila">
              <a class="nav__cabeza" href={item.url}
                 aria-current={rutaActual === item.url ? 'page' : undefined}
              >{item.texto}</a>
              <label for={`grupo-${n}`} class="nav__toggle"
                     aria-label={`Desplegar ${item.texto}`}></label>
            </div>
            {item.columnas ? (
              <div class="submenu submenu--mega">
                {item.columnas.map((c) => (
                  <div class="submenu__columna">
                    <p class="submenu__titulo">{c.titulo}</p>
                    <ul>
                      {c.enlaces.map((h) => (
                        <li>
                          <a href={h.url}
                             aria-current={rutaActual === h.url ? 'page' : undefined}
                          >{h.texto}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
                <p class="submenu__pie"><a href={item.todo.url}>{item.todo.texto}</a></p>
              </div>
            ) : (
              <ul class="submenu">
                {item.hijos.map((h) => (
                  <li>
                    <a href={h.url}
                       aria-current={rutaActual === h.url ? 'page' : undefined}
                    >{h.texto}</a>
                  </li>
                ))}
                {item.todo && (
                  <li class="submenu__cierre"><a href={item.todo.url}>{item.todo.texto}</a></li>
                )}
              </ul>
            )}
          </li>
        ) : (
          <li>
            <a href={item.url}
               aria-current={rutaActual === item.url ? 'page' : undefined}
            >{item.texto}</a>
          </li>
        ))}
        <li class="nav__cta"><a class="pildora" href={menu.cta.url}>{menu.cta.texto}</a></li>
      </ul>
    </nav>
  </div>
</header>
