---
import site from '../data/site.json';
const { url, titulo } = Astro.props;

/* Todas las URLs de esta web cuelgan de la raíz, así que el padre no se
   puede deducir de la ruta: se saca del menú. /casa/ es hija de
   /servicios-pintura/. Mismo criterio que el BreadcrumbList de Base.astro,
   para que la miga visible y la del schema no se contradigan. */
const PADRE = Object.fromEntries(
  site.navegacion.flatMap((e) =>
    e.url && e.hijos ? e.hijos.map((h) => [h.url, { url: e.url, texto: e.texto }]) : []
  )
);

const migas = [{ url: '/', texto: 'Portada' }];
if (PADRE[url]) migas.push(PADRE[url]);
if (url !== '/') migas.push({ url, texto: titulo, actual: true });
---
{migas.length > 1 && (
  <nav class="migas" aria-label="Migas de pan">
    <div class="contenedor">
      <ol>
        {migas.map((m, i) => (
          <li>
            {i > 0 && <span class="migas__sep" aria-hidden="true">»</span>}
            {m.actual
              ? <span aria-current="page">{m.texto}</span>
              : <a href={m.url}>{m.texto}</a>}
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}
