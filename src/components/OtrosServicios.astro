---
/* Bloque de "otros servicios" que se muestra en TODAS las páginas
   (lo incluye Base.astro). Son servicios habituales de una empresa de
   pintura que aún no tienen página propia; cada uno enlaza al
   presupuesto para captar la consulta. Editar la lista aquí lo cambia
   en todo el sitio a la vez. */
const servicios = [
  { texto: 'Pintura de exteriores', url: '/pintura-de-exteriores/' },
  { texto: 'Pintura decorativa y estucos', url: '/pintura-decorativa-estucos/' },
  { texto: 'Empapelado y papel pintado', url: '/empapelado-papel-pintado/' },
  { texto: 'Microcemento', url: '/microcemento/' },
  { texto: 'Barnizado de madera', url: '/barnizado-de-madera/' },
  { texto: 'Tratamiento de humedades y moho', url: '/tratamiento-humedades-moho/' },
  { texto: 'Pintura de comunidades de vecinos', url: '/pintores-para-comunidades/' },
  { texto: 'Pintura de locales y oficinas', url: '/pintores-para-empresas/' },
  { texto: 'Suelos epoxi para garajes', url: '/suelos-epoxi-garajes/' },
  { texto: 'Pintura ecológica y antibacteriana', url: '/pintura-ecologica-antibacteriana/' },
];
---
<section class="seccion seccion--alt">
  <div class="contenedor">
    <div class="prosa">
      <h2>Otros servicios que ofrecemos</h2>
      <p>Cuéntanos qué necesitas y te preparamos un presupuesto sin compromiso.</p>
    </div>
    <ul class="zonas">
      {servicios.map((s) => (
        <li><a href={s.url}>{s.texto}</a></li>
      ))}
    </ul>
  </div>
</section>
